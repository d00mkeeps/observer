# ALLOWED_TELEGRAM_USERS=12345678,87654321
# TELEGRAM_SECRET_TOKEN=optional_webhook_secret_token

# Antigravity / Gemini Intelligence:
GEMINI_API_KEY=your_gemini_api_key
